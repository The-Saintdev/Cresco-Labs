{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cresco-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cresco",
      "database_id": "52e68228-21ff-4cde-99f1-54e4c6d1870d",
      "migrations_dir": "db/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "cresco-uploads",
      "preview_bucket_name": "cresco-uploads-preview"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "GENERATION_QUEUE",
        "queue": "cresco-generations"
      }
    ],
    "consumers": [
      {
        "queue": "cresco-generations",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "cresco-generations-dlq"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "CRESCO_ALLOWED_ORIGINS": "https://cresco-labs.vercel.app",
    "CRESCO_PUBLIC_API_URL": "https://cresco-api.thesaintray5522.workers.dev",
    "CRESCO_FAL_QUEUE_URL": "https://queue.fal.run",
    "CRESCO_FAL_PLATFORM_URL": "https://api.fal.ai/v1",
    "CRESCO_BYTEPLUS_BASE_URL": "https://ark.ap-southeast.bytepluses.com/api/v3"
  },
  "secrets": {
    "required": [
      "CRESCO_TOKEN_SECRET",
      "CRESCO_ENCRYPTION_KEY",
      "CRESCO_PASSWORD_PEPPER",
      "CRESCO_ADMIN_EMAIL",
      "CRESCO_ADMIN_PASSWORD",
      "CRESCO_ASSET_SIGNING_SECRET"
    ]
  }
}
