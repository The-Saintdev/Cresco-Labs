{
  "name": "@cresco/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "cf:dev": "wrangler dev",
    "cf:check": "node scripts/check-deploy.mjs",
    "cf:deploy": "node scripts/check-deploy.mjs && wrangler deploy",
    "cf:types": "wrangler types",
    "cf:d1:local": "wrangler d1 migrations apply cresco --local",
    "cf:d1:remote": "wrangler d1 migrations apply cresco --remote"
  },
  "devDependencies": {
    "wrangler": "4.131.1"
  },
  "engines": {
    "node": ">=22"
  }
}
